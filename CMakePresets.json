{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CPM_SOURCE_CACHE": "$penv{HOME}/.cache/CPM",
        "GGUI_ENABLE_IMGUI_TEST_ENGINE": "ON"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja (Linux, tests on)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ninja-debug",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "coverage",
      "displayName": "Clang source-based coverage",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "GGUI_COVERAGE": "CLANG"
      }
    },
    {
      "name": "coverage-gcov",
      "displayName": "GCC gcov coverage (fallback)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GGUI_COVERAGE": "GCOV"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Linux, no test engine, static libstdc++; packages)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGUI_ENABLE_IMGUI_TEST_ENGINE": "OFF",
        "GGUI_STATIC_CXX_RUNTIME": "ON"
      }
    },
    {
      "name": "mingw-x64-static",
      "displayName": "MinGW x64, fully static (Schannel)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CPM_SOURCE_CACHE": "$penv{USERPROFILE}/.cache/CPM"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-x64",
      "displayName": "MSVC x64",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CPM_SOURCE_CACHE": "$penv{USERPROFILE}/.cache/CPM"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw-x64-cross",
      "displayName": "MinGW x64 static, cross-compiled from Linux (compile check)",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw-x64-static-release",
      "displayName": "MinGW x64, fully static, release (no test engine; packages)",
      "inherits": "mingw-x64-static",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGUI_ENABLE_IMGUI_TEST_ENGINE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-x64-release",
      "displayName": "MSVC x64, static CRT, release (no test engine; packages)",
      "inherits": "msvc-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGUI_ENABLE_IMGUI_TEST_ENGINE": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw-x64-cross-release",
      "displayName": "MinGW x64 static release, cross-compiled from Linux (package check)",
      "inherits": "mingw-x64-cross",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GGUI_ENABLE_IMGUI_TEST_ENGINE": "OFF"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja",
      "configurePreset": "ninja"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "coverage-gcov",
      "configurePreset": "coverage-gcov"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "mingw-x64-static",
      "configurePreset": "mingw-x64-static"
    },
    {
      "name": "msvc-x64",
      "configurePreset": "msvc-x64"
    },
    {
      "name": "mingw-x64-cross",
      "configurePreset": "mingw-x64-cross"
    },
    {
      "name": "mingw-x64-static-release",
      "configurePreset": "mingw-x64-static-release"
    },
    {
      "name": "msvc-x64-release",
      "configurePreset": "msvc-x64-release"
    },
    {
      "name": "mingw-x64-cross-release",
      "configurePreset": "mingw-x64-cross-release"
    }
  ],
  "packagePresets": [
    {
      "name": "package-linux",
      "configurePreset": "release",
      "generators": [
        "TGZ",
        "ZIP",
        "DEB"
      ],
      "packageDirectory": "${sourceDir}/build/packages"
    },
    {
      "name": "package-mingw",
      "configurePreset": "mingw-x64-static-release",
      "generators": [
        "ZIP"
      ],
      "packageDirectory": "${sourceDir}/build/packages"
    },
    {
      "name": "package-msvc",
      "configurePreset": "msvc-x64-release",
      "generators": [
        "ZIP"
      ],
      "packageDirectory": "${sourceDir}/build/packages"
    },
    {
      "name": "package-mingw-cross",
      "configurePreset": "mingw-x64-cross-release",
      "generators": [
        "ZIP"
      ],
      "packageDirectory": "${sourceDir}/build/packages"
    }
  ],
  "workflowPresets": [
    {
      "name": "package-linux",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "package",
          "name": "package-linux"
        }
      ]
    },
    {
      "name": "package-mingw",
      "steps": [
        {
          "type": "configure",
          "name": "mingw-x64-static-release"
        },
        {
          "type": "build",
          "name": "mingw-x64-static-release"
        },
        {
          "type": "package",
          "name": "package-mingw"
        }
      ]
    },
    {
      "name": "package-msvc",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-x64-release"
        },
        {
          "type": "build",
          "name": "msvc-x64-release"
        },
        {
          "type": "package",
          "name": "package-msvc"
        }
      ]
    },
    {
      "name": "package-mingw-cross",
      "steps": [
        {
          "type": "configure",
          "name": "mingw-x64-cross-release"
        },
        {
          "type": "build",
          "name": "mingw-x64-cross-release"
        },
        {
          "type": "package",
          "name": "package-mingw-cross"
        }
      ]
    }
  ]
}
