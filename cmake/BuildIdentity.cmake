# Run with cmake -P on each build. Inputs: SRC (source dir), OUT (generated .cpp), COMMIT (optional
# explicit commit). The commit is COMMIT, else the GITHUB_SHA environment variable, else empty
# (a local build: self-update is off). The time is the commit time (Unix seconds), or 0.
# OUT changes only when the content changes, so an unchanged commit does not relink.
set(commit "${COMMIT}")
if(commit STREQUAL "")
    set(commit "$ENV{GITHUB_SHA}")
endif()
set(time 0)
find_program(GIT_EXE git)
if(NOT commit STREQUAL "" AND GIT_EXE AND EXISTS "${SRC}/.git")
    execute_process(COMMAND ${GIT_EXE} -C "${SRC}" log -1 --format=%ct "${commit}"
        OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND out MATCHES "^[0-9]+$")
        set(time ${out})
    endif()
endif()
file(WRITE "${OUT}.tmp" "// Generated by cmake/BuildIdentity.cmake. Do not edit.
extern const char* const ggui_build_commit;
extern const long long ggui_build_time;
const char* const ggui_build_commit = \"${commit}\";
const long long ggui_build_time = ${time}LL;
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
